# OPPO PUSH 密钥模板（复制本文件为 app/oppo.properties 后填写真实值）
#
# 获取位置：OPPO 开放平台 → 推送服务 → 应用配置（AppKey / AppSecret）。
# app/oppo.properties 已在 .gitignore，绝不入库、不打印到日志/构建输出。
# 未配置（文件缺失或值为空）时：客户端跳过 HeytapPushManager.init/register 与 token 上传，
# 设置页「OPPO 推送」显示「未配置」，其余功能不受影响。
#
# 安全说明：OPPO PUSH 官方 SDK 要求在客户端完成 register(appKey, appSecret)，
# 因此这两个值会被编译进 BuildConfig（仅存在于本机构建产物；仓库与远端只有本模板）。
oppo.appKey=
oppo.appSecret=

# OPPO 账号服务 OAuth（账号快捷登录 / 一个学号最多绑定 3 个 OPPO 账号）
# 获取位置：OPPO 开放平台 → 账号服务 → 应用详情（AppID / AppKey）。
# 注意：账号服务凭证与推送凭证是两套（可能不同），不要混用。
# 未配置（任一为空）时：身份页不显示「OPPO 账号快捷登录」，「我的 → 账号」不显示 OPPO 账号入口；
# 其它功能不受影响。
oppo.accountAppId=
oppo.accountAppKey=
# 授权范围 scope（空格分隔；默认仅 openid=静默授权最小权限）。
# 如需昵称/unionid，先在开放平台为应用申请对应权限，再在下面填写平台要求的 scope。
# oppo.accountScope=openid

# 小布建议桌面课程提醒（端侧强调信息模板）。按 OPPO 联调确认的字段填写。
# https://open.oppomobile.com/documentation/page/info?id=13572
oppo.courseCard.intentName=
oppo.courseCard.launcherServiceId=
oppo.courseCard.entityName=
oppo.courseCard.milestoneCode=
oppo.courseCard.milestoneText=
