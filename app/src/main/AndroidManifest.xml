<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- v2 通知提醒（Android 13+ 运行时申请；拒绝时静默降级） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates：允许系统把 ongoing 通知升级为实时活动（ColorOS 16 流体云兼容） -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- v2 课表/通知写日程（运行时申请；拒绝时退回系统 ACTION_INSERT 兜底） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 重启后重新调度本地提醒（WorkManager 自身已声明，此处显式保留可读性） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      App 内更新（检测更新 → 下载 APK → 系统安装器确认安装）：
      - Android 8.0+ 安装 APK 需要用户授予「安装未知应用」；声明 REQUEST_INSTALL_PACKAGES 才能
        用 packageManager.canRequestPackageInstalls() 检测并跳转授权（不在前台静默安装）。
      - 下载优先系统 DownloadManager（写公共 Downloads，无需存储权限）；不可用时回退应用内
        OkHttp 下载到 cache/updates/，两条路径都经 FileProvider 交给系统安装器。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- OPPO 账号 OAuth：官方要求在 application 节点配置 MSP 开放平台生成的 APPID。
         1.1.3 AAR 虽未直接读取该 meta-data，但系统账号服务/H5 兜底可能通过宿主清单识别应用；
         值由 Gradle manifestPlaceholders 从 app/oppo.properties 的 oppo.accountAppId 注入。 -->
    <queries>
        <provider android:authorities="com.platform.usercenter.account.ams.provider" />
    </queries>

    <application
        android:name=".ClassToolsApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClassTools">

        <!-- OPPO 账号服务 APPID（官方文档：MSP 开放平台生成的 APPID；Authing 文档键名）。
             未配置时 manifestPlaceholders 为空串，不崩溃；账号入口由 BuildConfig 判定隐藏。 -->
        <meta-data
            android:name="com.heytap.msp.client.appid"
            android:value="${oppoAccountAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ClassTools"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".data.reminder.ReminderBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          OPPO PUSH（Heytap MCS SDK V4.0.0）官方快速接入：直连声明 SDK 自带回调服务，
          由系统推送通道（ColorOS/Heytap MCS）拉起；不继承重写透传消息，通知栏消息由 SDK 处理。
          - heytap 通道：permission com.heytap.mcs.permission.SEND_PUSH_MESSAGE
          - coloros 通道：permission com.coloros.mcs.permission.SEND_MCS_MESSAGE
          （AAR 自身已合并 DataMessageReceivingService 与 sdkVersion meta-data，无需重复声明）
        -->
        <service
            android:name="com.heytap.msp.push.service.DataMessageCallbackService"
            android:exported="true"
            android:permission="com.heytap.mcs.permission.SEND_PUSH_MESSAGE">
            <intent-filter>
                <action android:name="com.heytap.mcs.action.RECEIVE_MCS_MESSAGE" />
                <action android:name="com.heytap.msp.push.RECEIVE_MCS_MESSAGE" />
            </intent-filter>
        </service>

        <service
            android:name="com.heytap.msp.push.service.CompatibleDataMessageCallbackService"
            android:exported="true"
            android:permission="com.coloros.mcs.permission.SEND_MCS_MESSAGE">
            <intent-filter>
                <action android:name="com.coloros.mcs.action.RECEIVE_MCS_MESSAGE" />
            </intent-filter>
        </service>

        <provider            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ct_file_paths" />
        </provider>
    </application>

</manifest>
