<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="10dp"
    android:background="@drawable/timetable_widget_background">
    <LinearLayout android:id="@+id/widget_header" android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:id="@+id/widget_icon" android:layout_width="16dp" android:layout_height="16dp"
            android:layout_marginEnd="6dp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_heading" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="班级课表" android:fontFamily="sans-serif-medium" android:textSize="12sp" android:textColor="@color/widget_accent"
            android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/widget_summary" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:maxWidth="124dp" android:ellipsize="end"
            android:background="@drawable/widget_summary_pill" android:paddingHorizontal="6dp" android:paddingVertical="1dp"
            android:textColor="@color/widget_accent" android:textSize="11sp" android:includeFontPadding="false" android:singleLine="true" />
    </LinearLayout>
    <TextView android:id="@+id/widget_course" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="班级课表" android:textSize="18sp" android:textStyle="bold"
        android:textColor="@color/widget_ink" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_details" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textColor="@color/widget_accent" android:textSize="13sp" android:includeFontPadding="false"
        android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
    <LinearLayout android:id="@+id/widget_list" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
