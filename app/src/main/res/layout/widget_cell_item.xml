<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_cell_item" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:id="@+id/widget_event_rule" android:layout_width="3dp" android:layout_height="29dp" android:layout_marginEnd="5dp" android:src="@drawable/widget_rule_shape" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:minHeight="48dp" android:layout_weight="1">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_cell_title" android:includeFontPadding="false" android:textSize="15sp" android:textColor="@color/widget_ink" android:ellipsize="end" android:maxLines="1" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/widget_cell_detail" android:includeFontPadding="false" android:textSize="11sp" android:textColor="@color/widget_ink" android:ellipsize="end" android:maxLines="1" />
    </LinearLayout>
    <ImageButton android:id="@+id/widget_cell_check" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/widget_check_outline" android:scaleType="center" android:contentDescription="完成任务" android:visibility="gone" />
</LinearLayout>
