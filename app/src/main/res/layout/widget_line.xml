<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingBottom="3dp">

    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:id="@+id/widget_row_fill" android:layout_width="match_parent"
            android:layout_height="match_parent" android:src="@drawable/widget_band_shape"
            android:scaleType="fitXY" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="7dp">
            <ImageView android:id="@+id/widget_row_rule" android:layout_width="3dp" android:layout_height="24dp"
                android:src="@drawable/widget_rule_shape" android:scaleType="fitXY" android:importantForAccessibility="no" />

            <LinearLayout android:id="@+id/widget_row" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="3" android:orientation="vertical"
                    android:paddingStart="7dp" android:paddingEnd="6dp" android:paddingVertical="4dp">
                    <TextView android:id="@+id/widget_row_caption" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:includeFontPadding="false"
                        android:textSize="11sp" android:textStyle="bold" android:maxLines="1"
                        android:ellipsize="end" android:visibility="gone" />
                    <TextView android:id="@+id/widget_row_title" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:includeFontPadding="false"
                        android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
                    <TextView android:id="@+id/widget_row_detail" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:includeFontPadding="false"
                        android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
                <LinearLayout android:id="@+id/widget_row_side" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="2" android:orientation="vertical"
                    android:paddingEnd="6dp" android:paddingVertical="4dp" android:visibility="gone">
                    <TextView android:id="@+id/widget_row_side_detail" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:includeFontPadding="false"
                        android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
                    <TextView android:id="@+id/widget_row_excerpt" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:includeFontPadding="false"
                        android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/widget_row_open" android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:includeFontPadding="false" android:maxLines="1"
                android:text="列表" android:textSize="11sp" android:visibility="gone" />
            <ImageButton android:id="@+id/widget_row_check" android:layout_width="48dp" android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:scaleType="center"
                android:src="@drawable/widget_check_outline" android:contentDescription="完成任务" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
