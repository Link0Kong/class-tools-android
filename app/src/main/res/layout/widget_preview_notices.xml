        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="今天 09:20 发布" android:textSize="11sp" android:textColor="@color/widget_accent" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:fontFamily="sans-serif" />
