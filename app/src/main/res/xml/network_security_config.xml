<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 全部域名默认禁止明文（含 WebView / OkHttp / DownloadManager 等本 App 网络栈）。 -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- 教务系统仅 HTTP（契约 §5.1）：只对教务主机放行 cleartext，不全局打开。
         2026-11-18 自建后端切流：release 构建的 REST/ECS 服务（tool.furina.fun）全部走 HTTPS；
         ECS 备案前调试 IP 的明文入口只在 debug 构建放行（见 src/debug/res/xml/network_security_config.xml），
         release APK 不含该 IP 的明文放行。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">210.34.74.77</domain>
    </domain-config>
</network-security-config>
